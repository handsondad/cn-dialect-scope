  "etymology": [
    {
      "character": "浴",
      "note": "东汉《说文解字》分得很细：“沐，濯发也；浴，洒身也；洗，洒足也；澡，洒手也。”古汉语洗身叫“浴”，吴语“汏浴／淴浴”、闽语“洗浴”至今保留“浴”字；岭南天热，粤语、客家话把洗澡叫“冲凉”。",
      "confidence": "high",
      "sources": [
        "shuowen",
        "wiktionary-dial-syn"
      ]
    }
  ],

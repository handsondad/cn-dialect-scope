  "etymology": [
    {
      "character": "惊",
      "note": "“惊”从马、敬声，本义是马受惊，引申为畏惧。粤语（geng1）、客家话、闽南语（kiann）、潮汕话、福州话至今都把“害怕”单说一个“惊”字；山东济南常说“打怵”，东北口语常说“发毛”，南京话说“吓怕”。",
      "confidence": "high",
      "sources": [
        "wiktionary-dial-syn",
        "editorial"
      ]
    }
  ],

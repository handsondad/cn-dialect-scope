  "related": [],
  "etymology": [
    {
      "character": "谢",
      "note": "粤语把感谢分得很细：别人顺手帮忙、指路、倒茶说“唔该”（本义“不该劳烦你”），收到礼物、红包或重谢说“多谢”。客家话梅县常说“恁仔细”，潮汕话说“㩼谢”（很多谢）。",
      "confidence": "high",
      "sources": [
        "wiktionary-dial-syn",
        "editorial"
      ]
    }
  ],

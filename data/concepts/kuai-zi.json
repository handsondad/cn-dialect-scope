    {
      "character": "箸",
      "note": "古书里筷子叫“箸”，也叫“梜”。明代陆容《菽园杂记》说，吴地行船的人忌讳“住”（停住），就把“箸”反过来叫“快儿”，后来写成“筷”。",
      "confidence": "medium",
      "sources": [
        "wiktionary-dial-syn",
        "shuyuan-zaji"
      ]
    }

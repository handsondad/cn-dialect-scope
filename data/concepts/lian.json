  "etymology": [
    {
      "character": "面",
      "note": "先秦两汉管整张脸叫“面”（如《左传》“人心之不同，如其面焉”）；“脸”出现较晚，起初专指眼睛下方、两颊那一小块，唐宋以后才在北方扩大为整张脸。粤语、客家话、闽语至今把脸叫“面”、洗脸叫“洗面”，吴语上海、苏州叫“面孔”。",
      "confidence": "high",
      "sources": [
        "wiktionary-dial-syn",
        "editorial"
      ]
    }
  ],
